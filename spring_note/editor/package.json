{
  "private": true,
  "name": "springnote-editor",
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "@types/react": "19.3.0",
    "playwright": "1.64.0",
    "@types/react-dom": "19.3.0",
    "@types/markdown-it": "14.2.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.0",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/streamparser": "6.0.0",
    "@codemirror/view": "6.43.14",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "scripts": {
    "build:runtime": "node ../../tools/typora-lab/bundle.mjs",
    "verify:runtime": "node ../../tools/typora-lab/verify-bundle.mjs",
    "test:runtime": "node --test ../../tools/typora-lab/editor.test.mjs",
    "build": "vite build && node scripts/notices.mjs",
    "build:core": "vite build --config vite.core.config.ts && node scripts/core-assets.mjs && node scripts/notices.mjs dist-core/THIRD_PARTY_NOTICES.txt",
    "export:core": "npm run build:core && node scripts/export-core.mjs",
    "test:core": "npm run build:core && node --test tests/live-markdown-core.spec.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "version": "1.0.0",
  "type": "module"
}
